# Vanilla game data, extracted assets, build artifacts
extracted/
build/
screenshots/

# Pack and font binaries (copyrighted vanilla assets and generated packs)
*.pack
*.cuf
release/*.pack

# Exported vanilla loc/tsv
*.loc
*.tsv

# Third-party tools, venv, archives, and caches
tools/venv/
tools/rpfm-*/
tools/rpfm-*.zip
tools/etwng/
__pycache__/
*.pyc

# Logs: exclude all build/run logs, preserve baseline and pip-freeze
logs/*
!logs/baseline.txt
!logs/pip-freeze.txt
!logs/cr_*.txt
reference/

# Editor / agent-tool config, not part of the project
.zcodeignore
.zcode/
tw_attila_ar/backup/
tw_attila_ar/out/
tw_attila_ar/screenshots/
tw_attila_ar/quarantine/
tw_attila_ar/vendor/
*.zip
*.pdb
*.debo_broken
