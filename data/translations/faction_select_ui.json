    },
    {
      "key": "random_localisation_strings_string_campaign_difficulty_description_1",
      "table": "text/db/random_localisation_strings.loc",
      "ar": "للاعبين المعتادين على الألعاب الاستراتيجية والجدد على توتال وور.",
      "en": "For players familiar with strategy games but new to Total War."
    },
    {
      "key": "random_localisation_strings_string_campaign_difficulty_description_2",
      "table": "text/db/random_localisation_strings.loc",
